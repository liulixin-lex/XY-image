# Copy to .env.local for development or a server-only file with mode 600.
# API and Worker require the same encryption key and Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_PROJECT_ID=
SUPABASE_JWT_SECRET=
LOOMIC_SERVER_PORT=3001
LOOMIC_WEB_ORIGIN=http://localhost:3000
XY2API_BASE_URL=https://api.example.com
XY2API_WEB_URL=https://api.example.com
# Generate offline: openssl rand -base64 32. Never expose via NEXT_PUBLIC_*.
LOOMIC_SECRET_KEY=
SSO_EMAIL_DOMAIN=sso.draw.example.com
LOOMIC_CHAT_MODELS=gpt-5.4,gpt-6-luna,gpt-6-sol,gpt-5.4-mini,gpt-4.1,gpt-4o-mini
# Optional JSON catalog; see docs/XY2API_FRONTEND_HANDOFF.md and the default catalog.
LOOMIC_IMAGE_MODELS=
LOOMIC_MAX_CONCURRENT_JOBS=2
LOOMIC_MAX_IMAGES_PER_RUN=6
LOOMIC_SESSION_REVALIDATE_MINUTES=30
LOOMIC_IMAGE_OUTPUT_FORMAT=jpeg
LOOMIC_IMAGE_OUTPUT_COMPRESSION=90
# Enable only behind a trusted reverse proxy; bind API to loopback there.
LOOMIC_TRUST_PROXY=false
LOOMIC_EGRESS_IP=
LOOMIC_AGENT_MODEL=gpt-5.4
LOOMIC_AGENT_BACKEND_MODE=state
LOOMIC_SKILLS_ROOT=../../skills
WORKER_IMAGE_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=2000
WORKER_ID=w1
# Worker settles 待核对 image jobs from the xy2api usage list; "false" turns it off.
XY2API_BILLING_RECONCILE=true
GOOGLE_FONTS_API_KEY=
# Reserved for P1. Unsupported features remain disabled in P0.
XY2API_DEFAULT_KEY_GROUP_ID=
XY2API_EMBED_LOGIN_ENABLED=false
# Preflight is a paid diagnostic. Set these only in a private environment file.
PREFLIGHT_API_KEY=
# Required only when /v1/models omits image models: openai/grok/gemini/antigravity/composite.
PREFLIGHT_KEY_PLATFORM=
# Public build settings for the subsequent frontend implementation.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:3001
NEXT_PUBLIC_XY2API_WEB_URL=https://api.example.com


# Personal OpenAI-compatible chat providers: optional exact hostname allowlist.
# Empty allows any public HTTPS destination. Private/reserved IPs remain blocked.
# Uses direct egress (never HTTPS_PROXY); allow the destination in your outbound firewall.
LOOMIC_CHAT_PROVIDER_ALLOWED_HOSTS=
# Development only; ignored when NODE_ENV=production. Does not permit private IPs.
LOOMIC_CHAT_PROVIDER_ALLOW_HTTP=false

# Self-hosted: public URL generates browser Storage URLs; internal URL routes API calls privately.
# SUPABASE_INTERNAL_URL=http://api-gw:8000
# SUPABASE_JWT_ISSUER=https://supabase.your-domain.com/auth/v1
