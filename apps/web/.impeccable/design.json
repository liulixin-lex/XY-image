  "components": [
    {
      "name": "Poster Button",
      "kind": "button",
      "refersTo": "button-poster",
      "description": "珊瑚斜切主按钮：每屏最要紧的那个动作，下面一汪珊瑚光。",
      "html": "<button class=\"ds-btn-poster\"><span class=\"ds-sk-in\">生成 <b class=\"ds-num\">2</b> 张 <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></span></button>",
      "css": ".ds-btn-poster{display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 28px;border:none;border-radius:14px;background:var(--acc,#e5533d);color:var(--acc-ink,#fff);font:400 21px/1 \"GGUU Display\", \"Noto Sans SC\", \"PingFang SC\", system-ui, sans-serif;letter-spacing:.02em;transform:skewX(-10deg);box-shadow:0 14px 30px -12px var(--acc-glow,rgb(229 83 61/.42));cursor:pointer;transition:background-color .15s ease-out,transform .15s ease-out}.ds-btn-poster:hover{background:var(--acc-hover,#d6452f)}.ds-btn-poster:active{transform:skewX(-10deg) translateY(1px) scale(.98)}.ds-btn-poster:focus-visible{outline:2px solid var(--acc,#e5533d);outline-offset:2px}.ds-sk-in{display:inline-flex;align-items:center;gap:8px;transform:skewX(10deg)}.ds-num{font:800 28px/.9 \"Big Shoulders Display\", Geist, system-ui, sans-serif}"
    },
    {
      "name": "Ink Button",
      "kind": "button",
      "refersTo": "button-ink",
      "description": "墨色按钮：强的次要动作，暗色主题自动反色。",
