      "html": "<label class=\"ds-field\"><span class=\"ds-label\">提示词</span><textarea rows=\"3\" placeholder=\"写下你想要的画面\"></textarea></label>",
      "css": ".ds-field{display:grid;gap:10px;width:340px}.ds-label{font:400 17px/1 \"GGUU Display\", \"Noto Sans SC\", \"PingFang SC\", system-ui, sans-serif;letter-spacing:.02em;color:var(--fg,#24212b)}.ds-label::before{content:\"/\";color:var(--acc,#e5533d);margin-right:.12em}.ds-field textarea{resize:none;padding:12px 14px;border:none;border-radius:14px;background:var(--well,#f0ecee);color:var(--fg,#24212b);font:400 15px/1.7 Geist, \"Noto Sans SC\", \"PingFang SC\", system-ui, sans-serif;caret-color:var(--acc,#e5533d);box-shadow:inset 0 0 0 1px var(--line,rgb(36 33 43/.1));outline:none;transition:box-shadow .15s}.ds-field textarea::placeholder{color:var(--fg-muted,#6f6a78)}.ds-field textarea:focus{box-shadow:inset 0 0 0 1px var(--acc,#e5533d),0 0 0 3px var(--acc-soft,rgb(229 83 61/.11))}"
