      "html": "<figure class=\"ds-result\" aria-label=\"第 1 张（已选中）\"><div class=\"ds-pic\"></div><figcaption><b class=\"ds-idx\">01</b><span>3:4 · 2K · GPT Image 2</span></figcaption></figure>",
      "css": ".ds-result{margin:0;width:200px;display:grid;gap:10px}.ds-pic{aspect-ratio:3/4;border-radius:14px;background:linear-gradient(135deg,rgb(var(--amb,224 122 102)),rgb(var(--amb-2,196 70 128)));box-shadow:0 0 0 3px var(--ground,#f5f2f3),0 0 0 5px var(--acc,#e5533d),0 26px 46px -22px var(--acc-glow,rgb(229 83 61/.42))}.ds-result figcaption{display:flex;align-items:baseline;justify-content:space-between;color:var(--fg-muted,#6f6a78);font:400 11px/1.3 \"Geist Mono\",ui-monospace,monospace}.ds-idx{font:800 26px/.9 \"Big Shoulders Display\", Geist, system-ui, sans-serif;color:var(--fg,#24212b)}"
    },
