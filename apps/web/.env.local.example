# Supabase (public anon key only; never put the service role key here)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# XY Image API (apps/server). Its LOOMIC_WEB_ORIGIN must equal this site's origin.
NEXT_PUBLIC_SERVER_BASE_URL=http://127.0.0.1:3001

# xy2api main site, used for register / recharge / key links before the API
# answers. Runtime links from /api/auth/xy2api/config and /api/account win.
NEXT_PUBLIC_XY2API_WEB_URL=https://api.example.com
