{
  "deployDir": "/srv/xy-image/deployment",
  "backupRoot": "/srv/xy-image/backup-staging",
  "stateDir": "/srv/xy-image/operations-state",
  "resticEnvFile": "/etc/xy-image/restic.env",
  "alertFile": "/etc/xy-image/alert.json",
  "host": "xy-image-production",
