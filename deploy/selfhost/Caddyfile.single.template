# Single-domain deployment for Caddy (prepare.mjs --origin), the layout the
# pre-launch server has run since 2026-10-11. Same policy as
# nginx.single.conf.template: /api/* to XY API (/api/ready private),
# /supabase/* to the Supabase gateway with the prefix removed and only
# restricted Auth and object reads allowed, the static site for the rest.
# Caddy gets the certificate itself. Behind a CDN, set trusted_proxies in the
# global options first, or the login limiter sees the CDN's addresses.
__HOST__ {
	# defer: applied as the response is written, so "?" keeps headers the
	# API sets itself (e.g. /api/proxy-image CSP).
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		?Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The full policy, observed before it is enforced (FINDINGS W2):
		# violations go to /api/csp-report and the API log ("[csp]").
		?Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob: data:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; report-uri /api/csp-report"
	}
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@assets path /fonts/* /images/* /providers/* /favicon.svg /logo.svg /apple-touch-icon.png /og-image.png
	header @assets Cache-Control "public, max-age=604800"
	@pages not path /_next/static/* /fonts/* /images/* /providers/* /favicon.svg /logo.svg /apple-touch-icon.png /og-image.png /api/* /supabase/*
	header @pages Cache-Control "no-cache"
	handle_path /supabase/* {
		@allowed_auth expression `
			(method('OPTIONS') && path('/auth/v1/verify', '/auth/v1/logout', '/auth/v1/user', '/auth/v1/token')) ||
			(method('POST') && path('/auth/v1/verify') && {http.request.uri.query} == '') ||
			(method('GET') && path('/auth/v1/user') && {http.request.uri.query} == '') ||
			(method('POST') && path('/auth/v1/logout') && ({http.request.uri.query} == '' || {http.request.uri.query}.matches('^scope=(global|local|others)$'))) ||
			(method('POST') && path('/auth/v1/token') && {http.request.uri.query} == 'grant_type=refresh_token')
		`
		handle @allowed_auth {
			reverse_proxy 127.0.0.1:18000
		}
		@allowed_objects {
			method GET HEAD
			path_regexp ^/storage/v1/object/(public/project-assets|sign/[a-z0-9-]+)/.+$
		}
		handle @allowed_objects {
			reverse_proxy 127.0.0.1:18000
		}
		respond 404
	}
	@private_ready path /api/ready
	handle @private_ready {
		respond 404
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:3101
	}
	# The static export: /studio is studio.html, /auth/callback is
	# auth/callback.html. No fallback to the home page: a chunk a release
	# removed must be a 404, not HTML cached for a year as JavaScript
	# (FINDINGS E1); unknown pages get the site's own 404 page (E2).
	# publish-web.mjs writes the .br/.gz copies and keeps the last releases'
	# /_next/static files for pages still open.
	handle {
		root * __WEB_ROOT__
		try_files {path} {path}.html {path}/index.html
		file_server {
			precompressed br gzip
		}
	}
	handle_errors 404 {
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		@page not path /_next/* /fonts/* /images/* /providers/* /api/* /supabase/*
		handle @page {
			root * __WEB_ROOT__
			rewrite * /404.html
			file_server
		}
		respond "Not Found" 404
	}
	encode zstd gzip
	request_body {
		max_size 20MB
	}
}
