[Unit]
Description=XY-IMAGE health, disk and backup alert checks
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xy-ops
Group=xy-ops
SupplementaryGroups=docker
UMask=0077
WorkingDirectory=/opt/xy-image
ExecStart=/usr/bin/node /opt/xy-image/deploy/selfhost/operations.mjs monitor /etc/xy-image/operations.json
TimeoutStartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/xy-image
